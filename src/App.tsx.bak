      const topClusters = extractTopClusters(heatmapData, curPrice);
      const orderBookImbalance = computeWeightedImbalance(orderBook, dualDepth, dualTicker);

      const symbolObj = SUPPORTED_SYMBOLS.find(s => s.symbol === symbol);

