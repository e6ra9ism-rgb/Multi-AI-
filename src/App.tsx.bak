} from './lib/firebase';
import { onAuthStateChanged } from 'firebase/auth';

const computeWeightedImbalance = (orderBook: any, dualDepth: any, dualTicker: any) => {
  let orderBookImbalance = 1.0;
  if (dualDepth && dualTicker) {
    const bBids = (dualDepth.binance?.bids || []).reduce((acc: any, b: any) => acc + b.size, 0);
    const bAsks = (dualDepth.binance?.asks || []).reduce((acc: any, a: any) => acc + a.size, 0);
    const bImbalance = bAsks > 0 ? bBids / bAsks : 1.0;
    const bOI = dualTicker.binance?.openInterestUsd || 1000000;

    const hlBids = (dualDepth.hyperliquid?.bids || []).reduce((acc: any, b: any) => acc + b.size, 0);
    const hlAsks = (dualDepth.hyperliquid?.asks || []).reduce((acc: any, a: any) => acc + a.size, 0);
    const hlImbalance = hlAsks > 0 ? hlBids / hlAsks : 1.0;
    const hlOI = dualTicker.hyperliquid?.openInterestUsd || 1000000;

    const totalOI = bOI + hlOI;
    orderBookImbalance = ((bImbalance * bOI) + (hlImbalance * hlOI)) / (totalOI || 1);
  } else {
    const totalBids = (orderBook.bids || []).reduce((acc: any, b: any) => acc + b.size, 0);
    const totalAsks = (orderBook.asks || []).reduce((acc: any, a: any) => acc + a.size, 0);
    orderBookImbalance = totalAsks > 0 ? totalBids / totalAsks : 1.0;
  }
  return orderBookImbalance;
};

const extractTopClusters = (heatmapData: any, curPrice: number) => {
  if (!heatmapData || !heatmapData.cumulativeDepthByPrice) return [];
  return [...heatmapData.cumulativeDepthByPrice]
    .filter((c: any) => c.liqVolume > 0)
    .sort((a: any, b: any) => b.liqVolume - a.liqVolume)
    .slice(0, 10)
    .map((c: any) => ({
      price: c.price,
      side: c.price > curPrice ? 'SHORT_LIQ' : 'LONG_LIQ',
      volumeUsd: c.liqVolume,
      intensity: c.liqVolume / (heatmapData.maxIntensity || 1),
      clusterAgeMinutes: c.clusterAgeMinutes,
      phantomLiquidityRisk: c.phantomLiquidityRisk
    }));
};

