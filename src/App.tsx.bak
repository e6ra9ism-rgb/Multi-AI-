    const unsubTrades = subscribeToClosedTrades(userProfile.uid, (cloudTrades) => {
      setClosedTrades(cloudTrades || []);
      setFirestoreStatus('connected');
    });

    return () => {
      unsubPositions();
      unsubTrades();
    };
  }, [userProfile?.uid]);

  // Sync to local storage for guest session persistence
  useEffect(() => {
    try {
      localStorage.setItem('quant_trader_account', JSON.stringify(account));
    } catch (e) {
