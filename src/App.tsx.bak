    bitunixBalanceUsd: 0,
    bitunixAvailableBalanceUsd: 0,
  });

    const [closedTrades, setClosedTrades] = useState<ClosedTrade[]>([]);
  const [livePrices, setLivePrices] = useState<Record<string, number>>({});

  // Bitunix Real Exchange States
