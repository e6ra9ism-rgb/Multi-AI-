      if (savedLocalPos) {
        setActivePositions(JSON.parse(savedLocalPos));
      }
      const savedLocalTrades = localStorage.getItem('quant_closed_trades');
      if (savedLocalTrades) {
        setClosedTrades(JSON.parse(savedLocalTrades));
      }
    } catch (e) {
      console.warn('Local storage load warning:', e);
    }

    const unsubscribe = onAuthStateChanged(auth, async (user) => {
      if (user) {
        setUserProfile({
          uid: user.uid,
          email: user.email,
          displayName: user.displayName || 'Quant Trader',
          photoURL: user.photoURL,
          isAnonymous: user.isAnonymous,
        });

        // Load persisted account data from Firestore
        const savedAccount = await loadUserAccount(user.uid);
        if (savedAccount) {
          setAccount((prev) => ({ ...prev, ...savedAccount }));
        }
      } else {
        setUserProfile(null);
      }
    });

    return () => unsubscribe();
  }, []);

  // 2. Real-time Firestore Subscriptions for User's Positions and Trades
