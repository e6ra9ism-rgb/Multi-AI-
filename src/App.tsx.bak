    balanceUsd: 100000,
    initialBalanceUsd: 100000,
    equityUsd: 100000,
    totalRealizedPnlUsd: 0,
    winCount: 0,
    lossCount: 0,
    totalTrades: 0,
    autoTraderActive: false,
    autoTraderMinConfidence: 85,
    autoTraderDefaultLeverage: 100, // 100X default leverage
    autoTraderPositionSizeUsd: 10, // $10 default margin size
    autoTraderIntervalMinutes: 5, // Runs every 5 min after candle close
    lastProcessedCandleTime: 0,
    telegramBotToken: '',
    telegramChatId: '',
    telegramNotificationsEnabled: false,
    telegramAutoTradeExecutedOnly: false,
    executionMode: 'BITUNIX_REAL',
    bitunixApiKey: '',
    bitunixSecretKey: '',
